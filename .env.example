# Lead-enrichment agent — environment variable reference
# Copy this file to .env and fill in real values before running.

# LLM provider — LLM_MODEL selects the provider; set only the matching key.
#   OpenAI:     gpt-4o-mini                             -> OPENAI_API_KEY
#   Anthropic:  claude-3-5-sonnet-latest                -> ANTHROPIC_API_KEY
#   OpenRouter: openrouter/anthropic/claude-3.5-sonnet  -> OPENROUTER_API_KEY
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-replace-me
# ANTHROPIC_API_KEY=sk-ant-replace-me
# OPENROUTER_API_KEY=sk-or-replace-me

# Optional overrides (defaults shown)
# OPENAI_BASE_URL=https://my-proxy.example.com/v1
DATABASE_PATH=leads.db
# Optional: set to use PostgreSQL instead of SQLite
# DATABASE_URL=postgresql://user:password@localhost:5432/leads
MAX_CONCURRENT_SCRAPES=3
PAGE_TIMEOUT_MS=20000
LOG_LEVEL=INFO